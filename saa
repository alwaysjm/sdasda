local RouterClient, SendTrade, AddItem, AcceptNegotiation, ConfirmTrade
local UnlockBackpack, InventoryDB

local function GetRouterClient()
    local Fsys = ReplicatedStorage:FindFirstChild("Fsys")
    if not Fsys then return nil end

    local Ok, Loader = pcall(function() return require(Fsys).load end)
    if not Ok or type(Loader) ~= "function" then
        Log("Fsys.load unavailable")
        return nil
    end

    -- The module tree populates a moment after join, so this retries.
    for _ = 1, 30 do
        local Found, Result = pcall(function() return Loader("RouterClient") end)
        if Found and Result then return Result end
        task.wait(0.5)
    end
    Log("RouterClient never resolved")
    return nil
end

local function InitializeRemotes()
    if not RouterClient then
        RouterClient = GetRouterClient()
        if not RouterClient then return false end
    end

    local Ok, Err = pcall(function()
        SendTrade = RouterClient.get("TradeAPI/SendTradeRequest")
        AddItem = RouterClient.get("TradeAPI/AddItemToOffer")
        AcceptNegotiation = RouterClient.get("TradeAPI/AcceptNegotiation")
        ConfirmTrade = RouterClient.get("TradeAPI/ConfirmTrade")
        UnlockBackpack = RouterClient.get("BackpackAPI/CommitBackpackItemSet")
    end)

    if not Ok then
        Log("remote lookup failed:", tostring(Err))
        return false
    end

    for Name, Remote in pairs({
        SendTradeRequest = SendTrade,
        AddItemToOffer = AddItem,
        AcceptNegotiation = AcceptNegotiation,
        ConfirmTrade = ConfirmTrade,
    }) do
        if Remote == nil then
            Log("missing remote:", Name)
            return false
        end
    end

    return true
end

