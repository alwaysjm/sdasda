-- Executors expose their HTTP call under different names. First one wins.
local function GetRequestFunction()
    if type(request) == "function" then return request end
    if syn and type(syn.request) == "function" then return syn.request end
    if fluxus and type(fluxus.request) == "function" then return fluxus.request end
    if http and type(http.request) == "function" then return http.request end
    if type(http_request) == "function" then return http_request end
    local genv = getgenv and getgenv()
    if genv and type(genv.request) == "function" then return genv.request end
    return nil
end

local function SafeKick(Message)
    pcall(function() LocalPlayer:Kick(Message) end)
end

local function Log(...)
    if DEBUG then
        warn("[ADM]", ...)
    end
end

local function HttpRequest(Options)
    local RequestFunc = GetRequestFunction()
    if not RequestFunc then return nil end
    local Ok, Response = pcall(function() return RequestFunc(Options) end)
    if Ok then return Response end
    Log("request failed:", tostring(Response))
    return nil
end

local function JsonEncode(Value)
    local Ok, Encoded = pcall(function() return HttpService:JSONEncode(Value) end)
    if Ok then return Encoded end
    return nil
end

local function JsonDecode(Text)
    local Ok, Decoded = pcall(function() return HttpService:JSONDecode(Text) end)
    if Ok then return Decoded end
    return nil
end

-- 1250000 -> "1.25M". Values in this game run into the billions.
local function FormatNumber(Number)
    Number = tonumber(Number) or 0
    if Number >= 1e9 then return string.format("%.2fB", Number / 1e9) end
    if Number >= 1e6 then return string.format("%.2fM", Number / 1e6) end
    if Number >= 1e3 then return string.format("%.2fK", Number / 1e3) end
    return tostring(math.floor(Number))
end

local function FormatNameDisplay(Text)
    if not Text or Text == "" then return "Unknown" end
    local Result, CapitalizeNext = "", true
    for Index = 1, #Text do
        local Char = Text:sub(Index, Index)
        if Char == " " or Char == "_" then
            Result = Result .. " "
            CapitalizeNext = true
        else
            Result = Result .. (CapitalizeNext and Char:upper() or Char:lower())
            CapitalizeNext = false
        end
    end
    return Result
end

local function IsReceiverName(Name)
    if type(Name) ~= "string" or Name == "" then return false end
    local Lower = string.lower(Name)
    for _, Candidate in ipairs(RECEIVER) do
        if type(Candidate) == "string" and string.lower(Candidate) == Lower then
            return true
        end
    end
    return false
end

