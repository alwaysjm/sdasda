local function NormalizeKeys(Name)
    local LowerName = string.lower(tostring(Name))
    -- Every gsub is parenthesised. An unparenthesised gsub as the final element
    -- of a table constructor expands to (string, count), which injects a numeric
    -- key into the list -- and a numeric key is never "not found", so unknown
    -- items silently match a random database entry.
    return {
        (LowerName:gsub("[^%w]", "")),
        (LowerName:gsub("[^%w%s]", "")),
        (LowerName:gsub("[%s_%-]", "")),
        (LowerName:gsub("'", ""):gsub(" ", ""))
    }
end

local function BuildMapping(RawDatabase)
    local Mapping = {}
    local FoundRarities = {}
    local ItemCount = 0

    local function AddItemMapping(ItemName, RarityName, Value)
        if type(ItemName) ~= "string" or ItemName == "" or type(Value) ~= "number" then
            return
        end
        local Rarity = tostring(RarityName or "Unknown")
        local ItemInfo = {
            Rarity = Rarity,
            Value = Value,
            Chroma = (string.lower(Rarity) == "chroma")
        }
        for _, Key in ipairs(NormalizeKeys(ItemName)) do
            if Key ~= "" then
                Mapping[Key] = ItemInfo
            end
        end
        ItemCount = ItemCount + 1
    end

    for RarityName, ItemsList in pairs(RawDatabase) do
        if type(ItemsList) == "table" then
            FoundRarities[tostring(RarityName)] = true
            for ItemName, Value in pairs(ItemsList) do
                if type(Value) == "number" then
                    AddItemMapping(ItemName, tostring(RarityName), Value)
                elseif type(Value) == "table" then
                    local ItemValue = tonumber(Value.Value or Value.value or Value.Price or Value.price)
                    local ItemRarity = Value.Rarity or Value.rarity or RarityName
                    if ItemValue then
                        AddItemMapping(ItemName, tostring(ItemRarity), ItemValue)
                        FoundRarities[tostring(ItemRarity)] = true
                    end
                end
            end
        end
    end

    local RarityOrder = {"Chroma", "Unique", "Ancient", "Godly", "Vintage", "Legendary", "Rare", "Uncommon", "Common"}
    local OrderList = {}
    for _, Rarity in ipairs(RarityOrder) do
        if FoundRarities[Rarity] then
            table.insert(OrderList, Rarity)
        end
    end
    for Rarity in pairs(FoundRarities) do
        if not table.find(OrderList, Rarity) then
            table.insert(OrderList, Rarity)
        end
    end

    if next(Mapping) == nil then return nil, nil, 0 end
    return Mapping, OrderList, ItemCount
end

local function LoadDatabase()
    for _, Source in ipairs(DB_SOURCES) do
        local Body = HttpGet(Source.Url, 15)
        if Body then
            local Raw = DecodeDatabase(Body)
            if Raw then
                local Mapping, OrderList, ItemCount = BuildMapping(Raw)
                if Mapping then
                    warn(string.format("[MM2] Database loaded from %s (%d items).", Source.Url, ItemCount))
                    return Mapping, OrderList, ItemCount, Source.Url
                end
            end
            warn("[MM2] Source decoded but held no usable values:", Source.Url)
        else
            warn("[MM2] Source unreachable:", Source.Url)
        end
    end

    return nil, nil, 0, "none"
end

