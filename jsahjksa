-- True only for a rarity -> item -> number shaped table. A payload that decodes
-- into anything else must not be mistaken for a database.
local function LooksLikeDatabase(Candidate)
    if type(Candidate) ~= "table" then return false end
    for _, Section in pairs(Candidate) do
        if type(Section) == "table" then
            for _, Value in pairs(Section) do
                if type(Value) == "number" then return true end
            end
        end
    end
    return false
end

local function RunChunk(Source)
    local Ok, Result = pcall(function()
        local Loader = loadstring(Source)
        if not Loader then return nil end
        return Loader()
    end)
    if Ok and LooksLikeDatabase(Result) then return Result end
    return nil
end

local function DecodeDatabase(Body)
    if type(Body) ~= "string" or #Body < 2 then return nil end

    -- JSON first: works without loadstring.
    local OkJSON, JSONResult = pcall(function()
        return HttpService:JSONDecode(Body)
    end)
    if OkJSON and LooksLikeDatabase(JSONResult) then return JSONResult end

    -- Plain Lua table expression (the pastefy shape).
    local Direct = RunChunk(Body)
    if Direct then return Direct end

    -- Whitespace-collapsed variant, for payloads that rely on it.
    return RunChunk((Body:gsub("%s+", "")))
end

